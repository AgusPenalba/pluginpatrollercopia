{{!
👥 VISTA DE GRUPO
Información detallada del grupo del estudiante
}}

<!-- 🎨 ENCABEZADO DE PÁGINA -->
<div class="container-fluid mb-4">
    <div class="row">
        <div class="col-12">
            <div class="page-header bg-primary text-white rounded p-3 mb-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h1 class="h3 mb-0">
                            <i class="{{header_icon}}"></i>
                            Grupo {{repository_info.number}}
                        </h1>
                        <p class="mb-0 mt-1 opacity-75">{{header_subtitle}}</p>
                    </div>
                    <div class="text-right">
                        <small class="d-block opacity-75">{{course_name}}</small>
                        {{#user_fullname}}
                        <small class="d-block opacity-75">
                            <i class="fas fa-user"></i> {{user_fullname}}
                        </small>
                        {{/user_fullname}}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <!-- MENSAJES DE ALERTA -->
    {{#success_message}}
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i>
        <strong>¡Éxito!</strong> {{success_message}}
        <button type="button" class="close" data-dismiss="alert" aria-label="Cerrar">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
    {{/success_message}}

    {{#error_message}}
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle"></i>
        <strong>Error:</strong> {{error_message}}
        <button type="button" class="close" data-dismiss="alert" aria-label="Cerrar">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
    {{/error_message}}

    <!-- 📊 INFORMACIÓN DEL GRUPO -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-info-circle"></i>
                        Información del Grupo
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-12 col-md-4">
                            <h6><i class="fas fa-map-marker-alt"></i> Sede y Curso</h6>
                            <p class="text-muted mb-0">{{group_info.display_name}}</p>
                        </div>
                        <div class="col-12 col-md-4">
                            <h6><i class="fas fa-users"></i> Total de Miembros</h6>
                            <p class="text-muted mb-0">{{group_stats.total_students}} estudiantes</p>
                        </div>
                        <div class="col-12 col-md-4">
                            <h6><i class="fas fa-tag"></i> Repositorio</h6>
                            <p class="text-muted mb-0">
                                {{#repository_url}}
                                    <a href="{{repository_url}}" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary">
                                        <i class="fab fa-github"></i>
                                        <span class="ml-1">{{repository_info.name}}</span>
                                    </a>
                                {{/repository_url}}
                                {{^repository_url}}
                                    {{repository_info.name}}
                                {{/repository_url}}
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- =================== PANEL SEGUIMIENTO Y CALIFICACIÓN (inserción desde contributors_insights) =================== -->
    {{#has_students}}
    <div class="row mt-4 mb-4">
        <div class="col-12">
            <form method="post" action="">
                <input type="hidden" name="id" value="{{cm_id}}">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-chart-line"></i>
                            Seguimiento y Calificación
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover mb-0" id="dataTable">
                                <thead class="thead-dark">
                                    <tr>
                                        <th>Nombre </th> 
                                        <th><i class="fab fa-github"></i> Usuario GitHub</th>
                                       
                                        <th>Último Commit</th>
                                        <th>Commits</th>
                                        <th>Líneas +</th>
                                        <th>Líneas -</th>
                                        <th>Modificadas</th>
                                        <th>Calificación</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#students}}
                                    <tr {{#is_current_user}}class="table-warning"{{/is_current_user}}>
                                        
                                        
                                        <td>
                                            {{#is_current_user}}
                                                <strong>{{full_name}} (Tú)</strong>
                                            {{/is_current_user}}
                                            {{^is_current_user}}
                                                {{full_name}}
                                            {{/is_current_user}}
                                        </td>
                                        <td>{{github_username}}</td>
                                        <td>{{last_commit_date}}</td>
                                        <td>{{commit_count}}</td>
                                        <td>{{lines_added}}</td>
                                        <td>{{lines_deleted}}</td>
                                        <td>{{lines_modified}}</td>
                                        <td>
                                            <span id="grade-display-{{student_id}}">
                                                {{#grade_empty}}
                                                    <span class="text-muted">Sin nota</span>
                                                {{/grade_empty}}
                                                {{^grade_empty}}
                                                    <span>{{grade}}</span>
                                                {{/grade_empty}}
                                                
                                            </span>
                                            
                                        </td>
                                    </tr>
                                    {{/students}}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
    {{/has_students}}



<!-- =================== SECCIÓN ESTADÍSTICAS  =================== -->

    <div class="row mb-4">
        <div class="col-12">
            <div class="card h-100 d-flex flex-column">
                <div class="card-header d-flex justify-content-between align-items-center bg-secondary text-white">
                    <h5 class="mb-0"><i class="fas fa-chart-pie"></i> Estadísticas</h5>
                    <div>
                        <label for="metricSelectorFooter" class="sr-only">Métrica</label>
                        <select id="metricSelectorFooter" class="form-control form-control-sm" onchange="(function(v){window.switchBarMetric(v); var s=document.getElementById('metricSelector'); if(s) s.value=v; })(this.value);">
                            <option value="commits" selected>Commits</option>
                            <option value="lines">Líneas agregadas</option>
                        </select>
                    </div>
                </div>
                <div class="card-body flex-fill">
                    <div class="row">
                        <div class="col-md-8">
                            <div style="min-height:260px;">
                                <canvas id="commitsBarChart"></canvas>
                            </div>
                        </div>
                        <div class="col-md-4 text-center">
                            <div style="min-height:260px; display:flex; align-items:center; justify-content:center;">
                                <canvas id="commitsPieChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- Chart.js desde CDN -->
<!-- Debug panel removed in cleanup - keep debug accessible only via server logs -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    try {

    // Usar los arrays desde el backend (chart_*_json). Si no existen, usar arrays vacíos.
    const labels = {{#chart_labels_json}}{{{chart_labels_json}}}{{/chart_labels_json}}{{^chart_labels_json}}[]{{/chart_labels_json}};
    const commits = {{#chart_commits_json}}{{{chart_commits_json}}}{{/chart_commits_json}}{{^chart_commits_json}}[]{{/chart_commits_json}};
    const lines = {{#chart_lines_json}}{{{chart_lines_json}}}{{/chart_lines_json}}{{^chart_lines_json}}[]{{/chart_lines_json}};
    const lines_added = {{#chart_lines_added_json}}{{{chart_lines_added_json}}}{{/chart_lines_added_json}}{{^chart_lines_added_json}}[]{{/chart_lines_added_json}};
    const lines_deleted = {{#chart_lines_deleted_json}}{{{chart_lines_deleted_json}}}{{/chart_lines_deleted_json}}{{^chart_lines_deleted_json}}[]{{/chart_lines_deleted_json}};
    const lines_modified = {{#chart_lines_modified_json}}{{{chart_lines_modified_json}}}{{/chart_lines_modified_json}}{{^chart_lines_modified_json}}[]{{/chart_lines_modified_json}};

        // Normalize arrays: ensure numeric types and same length as labels
        function toNumberArray(arr) {
            try {
                if (!Array.isArray(arr)) return [];
                return arr.map(v => {
                    if (v === null || v === undefined) return 0;
                    if (typeof v === 'number') return v;
                    let s = String(v).trim();
                    // remove thousand separators and normalize comma decimals
                    s = s.replace(/\./g, '').replace(/,/g, '.');
                    const n = Number(s);
                    return isNaN(n) ? 0 : n;
                });
            } catch (e) { return []; }
        }

        const N = labels ? labels.length : 0;
        const commitsN = toNumberArray(commits).slice(0, N);
        while (commitsN.length < N) commitsN.push(0);
        const lines_addedN = toNumberArray(lines_added).slice(0, N); while (lines_addedN.length < N) lines_addedN.push(0);
        const lines_deletedN = toNumberArray(lines_deleted).slice(0, N); while (lines_deletedN.length < N) lines_deletedN.push(0);
        const lines_modifiedN = toNumberArray(lines_modified).slice(0, N); while (lines_modifiedN.length < N) lines_modifiedN.push(0);

        // override arrays used by charts
        commits.length = 0; commits.push(...commitsN);
        lines_added.length = 0; lines_added.push(...lines_addedN);
        lines_deleted.length = 0; lines_deleted.push(...lines_deletedN);
        lines_modified.length = 0; lines_modified.push(...lines_modifiedN);

        // expose arrays for debug panel and external access
        try {
            window.labels = labels;
            window.commits = commits;
            window.lines_added = lines_added;
            window.lines_deleted = lines_deleted;
            window.lines_modified = lines_modified;
            if (typeof window.__pp_fill_debug === 'function') window.__pp_fill_debug();
        } catch (e) { /* ignore */ }

    // Arrays prepared for charts (labels, commits, lines_added, lines_deleted, lines_modified)

        // Bar chart - commits por alumno
        const ctxBar = document.getElementById('commitsBarChart').getContext('2d');
        let barChart = new Chart(ctxBar, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{ label: 'Commits', data: commits, backgroundColor: 'rgba(54, 162, 235, 0.6)' }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: { y: { beginAtZero: true } }
            }
        });

        // Pie chart - porcentaje de commits
    const ctxPie = document.getElementById('commitsPieChart').getContext('2d');
    function generatePalette(n) {
            const predefined = ['#2ecc71','#e74c3c','#f1c40f','#3498db','#9b59b6','#e67e22','#1abc9c','#34495e','#8e44ad','#d35400','#16a085','#7f8c8d'];
            if (n <= predefined.length) return predefined.slice(0, n);
            const colors = [];
            for (let i = 0; i < n; i++) {
                const hue = Math.round((i * 360) / n);
                colors.push(`hsl(${hue} 75% 45%)`);
            }
            return colors;
        }

        let pieChart = new Chart(ctxPie, {
            type: 'pie',
            data: { labels: labels, datasets: [{ label: 'Commits', data: commits, backgroundColor: generatePalette(labels.length) }] },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: true },
                    title: { display: true, text: 'Commits' }
                }
            }
        });
        // expose globally so switchBarMetric can reference it reliably
        window.pieChartInstance = pieChart;
        window.barChartInstance = barChart;

        // Simple toggle to switch bar metric
        window.switchBarMetric = function(metric) {
            // switch metric between 'commits' and 'lines'
            // Recreate the bar chart to ensure grouped datasets render correctly
            try { if (barChart) barChart.destroy(); } catch (e) { /* ignore destroy errors */ }
            if (metric === 'lines') {
                barChart = new Chart(ctxBar, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [
                            { label: 'Líneas agregadas', data: lines_added, backgroundColor: 'rgba(40, 167, 69, 0.7)' },
                            { label: 'Líneas eliminadas', data: lines_deleted, backgroundColor: 'rgba(220, 53, 69, 0.7)' },
                            { label: 'Líneas modificadas', data: lines_modified, backgroundColor: 'rgba(255, 193, 7, 0.7)' }
                        ]
                    },
                    options: { responsive: true, maintainAspectRatio: false, scales: { y: { beginAtZero: true } } }
                });
            } else {
                barChart = new Chart(ctxBar, {
                    type: 'bar',
                    data: { labels: labels, datasets: [{ label: 'Commits', data: commits, backgroundColor: 'rgba(54, 162, 235, 0.6)' }] },
                    options: { responsive: true, maintainAspectRatio: false, scales: { y: { beginAtZero: true } } }
                });
            }
            window.barChartInstance = barChart;
            // update pie chart dataset and title if present
            try {
                if (window.pieChartInstance) {
                    // pieChartInstance exists; update dataset
                    if (metric === 'lines') {
                        window.pieChartInstance.data.datasets[0].data = lines_added;
                        window.pieChartInstance.data.datasets[0].label = 'Líneas agregadas';
                        // ensure palette matches number of labels
                        try {
                            window.pieChartInstance.data.datasets[0].backgroundColor = generatePalette(labels.length);
                        } catch (palErr) { /* ignore palette errors */ }
                        if (window.pieChartInstance.options && window.pieChartInstance.options.plugins && window.pieChartInstance.options.plugins.title) {
                            window.pieChartInstance.options.plugins.title.text = 'Líneas agregadas';
                        }
                    } else {
                        window.pieChartInstance.data.datasets[0].data = commits;
                        window.pieChartInstance.data.datasets[0].label = 'Commits';
                        try {
                            window.pieChartInstance.data.datasets[0].backgroundColor = generatePalette(labels.length);
                        } catch (palErr) { /* ignore palette generation error */ }
                        if (window.pieChartInstance.options && window.pieChartInstance.options.plugins && window.pieChartInstance.options.plugins.title) {
                            window.pieChartInstance.options.plugins.title.text = 'Commits';
                        }
                    }
                    // updated pie dataset
                    window.pieChartInstance.update();
                } else {
                    // pie chart instance not available
                }
            } catch (err) { console.warn('No se pudo actualizar pie chart:', err); }
            barChart.update();
        };
    } catch (e) {
        console.error('Error al renderizar gráficos:', e);
    }
});
</script>

<style>
/* Estilos personalizados para la vista de grupo */
.page-header {
    background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
}

.card-header {
    font-weight: 600;
}

.progress {
    height: 8px;
    margin-top: 5px;
}

.badge {
    font-size: 0.8em;
}

.table th {
    font-weight: 600;
    border-top: none;
}

.table-warning {
    background-color: #fff3cd !important;
}

/* Animaciones suaves */
.card {
    transition: transform 0.2s ease-in-out;
}

.card:hover {
    transform: translateY(-2px);
}

/* Responsive adjustments */
@media (max-width: 768px) {
    .card-body .row > div {
        margin-bottom: 1rem;
    }
}
</style>