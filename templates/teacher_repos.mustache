                                   required>
                            <div class="input-group-append">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fa fa-save"></i> Guardar
                                </button>
                            </div>
                        </div>
                        {{#has_valid_username}}
                        <small class="form-text text-success">
                            <i class="fa fa-check-circle"></i> Usuario configurado correctamente
                        </small>
                        {{/has_valid_username}}
                        {{^has_valid_username}}
                        <small class="form-text text-warning">
                            <i class="fa fa-exclamation-triangle"></i> Configura tu usuario de GitHub para poder asignar repositorios
                        </small>
                        {{/has_valid_username}}
                        
                        {{#has_my_repos}}
                        <small class="form-text text-info mt-2">
                            <i class="fa fa-info-circle"></i> 
                            <strong>Atención:</strong> Si cambias tu usuario de GitHub, serás removido como colaborador 
