                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="action" value="syncinvitations">
                    <button type="submit" class="btn btn-light btn-sm" id="sync-button" title="Sincronizar estados con GitHub">
                        <i class="fa fa-sync-alt"></i> Sincronizar Estados
                    </button>
                </form>
                {{/has_valid_username}}
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover" id="my-repos-table">
                        <thead>
                            <tr>
                                <th>Repositorio</th>
                                <th>Sede</th>
                                <th>Curso</th>
                                <th>Grupo</th>
