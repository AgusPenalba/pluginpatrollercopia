                <h5 class="mb-0">
                    <i class="fa fa-folder-open"></i> Repositorios Disponibles para Asignar
                </h5>
                <span class="badge badge-light" id="selection-counter">
                    <i class="fa fa-check-square"></i> 0 seleccionados
                </span>
            </div>
            <div class="card-body">
                {{^has_valid_username}}
                <div class="alert alert-warning">
                    <i class="fa fa-exclamation-triangle"></i> 
                    Debes configurar tu nombre de usuario de GitHub antes de poder asignar repositorios.
                </div>
                {{/has_valid_username}}
                
                <form method="post" action="" id="bulk-assign-form">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="action" value="assignmultiplerepos">
                    
                    <div class="table-responsive">
                        <table class="table table-striped table-hover" id="unassigned-repos-table">
                            <thead>
                                <tr>
                                    <th width="50">
                                        {{#has_valid_username}}
                                        <input type="checkbox" 
                                               id="select-all-repos" 
                                               title="Seleccionar/Deseleccionar todos"
                                               class="repo-checkbox-control">
                                        {{/has_valid_username}}
                                    </th>
                                    <th>Repositorio</th>
                                    <th>Sede</th>
                                    <th>Curso</th>
                                    <th>Grupo</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#unassigned_repos}}
                                <tr>
                                    <td>
                                        {{#has_valid_username}}
                                        <!-- CORREGIDO: Usar {{name}} sin corchetes y procesarlo en el controlador -->
                                        <input type="checkbox" 
                                               name="repo_ids" 
                                               value="{{id}}"
                                               class="repo-checkbox"
                                               data-repo-name="{{nombre}}">
                                        {{/has_valid_username}}
                                        {{^has_valid_username}}
                                        <input type="checkbox" disabled title="Configure su usuario GitHub primero">
                                        {{/has_valid_username}}
                                    </td>
                                    <td><strong>{{nombre}}</strong></td>
                                    <td>{{sede}}</td>
                                    <td>{{curso}}</td>
                                    <td>{{grupo}}</td>
                                </tr>
                                {{/unassigned_repos}}
                            </tbody>
                        </table>
                    </div>
                    
                    {{#has_valid_username}}
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <div class="alert alert-info mb-0 flex-grow-1 mr-3" style="max-width: 70%;">
                            <i class="fa fa-info-circle"></i>
                            <strong>Límite:</strong> Puedes asignar hasta <strong>10 repositorios</strong> por operación.
                            Selecciona los repositorios que deseas asignar.
                        </div>
                        <button type="submit" 
                                class="btn btn-success btn-lg" 
                                id="bulk-assign-btn"
                                disabled
                                title="Selecciona al menos un repositorio">
                            <i class="fa fa-plus-circle"></i> Asignar Repositorios Seleccionados
                        </button>
                    </div>
                    {{/has_valid_username}}
                </form>
            </div>
        </div>
        {{/has_unassigned_repos}}

        {{#has_other_teachers_repos}}
        <!-- Tabla de Repositorios Asignados a Otros Profesores -->
        <div class="card mb-3">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">
                    <i class="fa fa-users"></i> Repositorios Asignados a Otros Profesores
                </h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover" id="other-repos-table">
                        <thead>
                            <tr>
                                <th>Repositorio</th>
                                <th>Sede</th>
                                <th>Curso</th>
                                <th>Grupo</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#other_teachers_repos}}
                            <tr>
                                <td><strong>{{nombre}}</strong></td>
                                <td>{{sede}}</td>
                                <td>{{curso}}</td>
                                <td>{{grupo}}</td>
                                <td>
                                    <span class="badge {{status_class}}">
                                        {{{status_icon}}} {{mensaje}}
                                    </span>
                                </td>
                            </tr>
                            {{/other_teachers_repos}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        {{/has_other_teachers_repos}}
        
    {{/has_repos}}
    
    {{^has_repos}}
    <div class="alert alert-warning">
        <i class="fa fa-exclamation-triangle"></i> No hay repositorios disponibles en este curso.
    </div>
