<div class="teacher-repos-container p-3">
    {{#has_repos}}
        <!-- Sección de nombre de usuario GitHub -->
        <div class="card mb-3">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="fa fa-github"></i> Usuario GitHub
                </h5>
            </div>
            <div class="card-body">
                <form method="post" action="" id="github-username-form">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="action" value="savegithubusername">
                    <input type="hidden" id="current-username" value="{{github_username}}">
                    
