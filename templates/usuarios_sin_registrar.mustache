{{!
👥 UNREGISTERED USERS
List of enrolled students pending registration in GitPatroller
}}

<!-- 🎨 PAGE HEADER -->
<div class="container-fluid mb-4">
    <div class="row">
        <div class="col-12">
            <div class="page-header bg-primary text-white rounded p-3 mb-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h1 class="h3 mb-0">
                            <i class="fas fa-user-times"></i>
                            {{#str}}unregisteredusers, mod_pluginpatroller{{/str}}
                        </h1>
                        <p class="mb-0 mt-1 opacity-75">{{#str}}enrolledstudentspending, mod_pluginpatroller{{/str}}</p>
                    </div>
                    <div class="text-right">
                        <small class="d-block opacity-75">{{course_name}}</small>
                        {{#user_fullname}}
                        <small class="d-block opacity-75">
                            <i class="fas fa-user"></i> {{user_fullname}}
                        </small>
                        {{/user_fullname}}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">

    <!-- 🔍 FILTERS SECTION -->
    {{#has_unregistered}}
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-filter"></i> {{#str}}searchfilters, mod_pluginpatroller{{/str}}
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        {{#filters}}
                        <div class="col-md-3 mb-2">
                            <label for="{{id}}" class="form-label">{{label}}</label>
                            {{#is_text}}
                                <input type="text" 
                                       id="{{id}}" 
                                       class="form-control" 
                                       placeholder="{{placeholder}}" 
                                       oninput="filterTable('{{table_id}}')" />
                            {{/is_text}}
                            {{#is_select}}
                                <select id="{{id}}" class="form-control" onchange="filterTable('{{table_id}}')">
                                    {{#options}}
                                        <option value="{{value}}">{{label}}</option>
                                    {{/options}}
                                </select>
                            {{/is_select}}
                        </div>
                        {{/filters}}
                        <div class="col-md-3 mb-2 d-flex align-items-end">
                            <button type="button" class="btn btn-outline-secondary" onclick="clearAllFilters('unregisteredTable')">
                                <i class="fas fa-times"></i> {{#str}}clearfilters, mod_pluginpatroller{{/str}}
                            </button>
                        </div>
                    </div>
                    <div class="row mt-2">
                        <div class="col-12">
                            <small id="filterCounter" class="text-muted"></small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {{/has_unregistered}}

    <!-- Tabla de usuarios sin registrar -->
    {{#has_unregistered}}
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-users"></i>
                        {{total_unregistered}} {{#str}}studentsunregistered, mod_pluginpatroller{{/str}}
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0" id="unregisteredTable">
                            <thead class="thead-light">
                                <tr data-sede="{{sede}}" data-curso="{{curso}}">
                                    <th scope="col">
                                        <i class="fas fa-map-marker-alt"></i>
                                        {{#str}}sede, mod_pluginpatroller{{/str}}
                                    </th>
                                    <th scope="col">
                                        <i class="fas fa-graduation-cap"></i>
                                        {{#str}}course, mod_pluginpatroller{{/str}}
                                    </th>
                                    <th scope="col">
                                        <i class="fas fa-user"></i>
                                        {{#str}}virtualclassroomuser, mod_pluginpatroller{{/str}}
                                    </th>
                                    <th scope="col">
                                        <i class="fas fa-id-card"></i>
                                        {{#str}}fullname, mod_pluginpatroller{{/str}}
                                    </th>
                                    <th scope="col">
                                        <i class="fas fa-envelope"></i>
                                        {{#str}}email, mod_pluginpatroller{{/str}}
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#unregistered_students}}
                                <tr data-sede="{{sede}}" data-curso="{{curso}}">
                                    <td>
                                        {{#sede}}
                                            <span class="badge badge-primary">{{sede}}</span>
                                        {{/sede}}
                                        {{^sede}}
                                            <span class="badge badge-secondary">{{#str}}unassigned, mod_pluginpatroller{{/str}}</span>
                                        {{/sede}}
                                    </td>
                                    <td>
                                        {{#curso}}
                                            <span class="badge badge-info">{{curso}}</span>
                                        {{/curso}}
                                        {{^curso}}
                                            <span class="badge badge-secondary">{{#str}}unassigned, mod_pluginpatroller{{/str}}</span>
                                        {{/curso}}
                                    </td>
                                    <td>
                                        <strong>{{username}}</strong>
                                    </td>
                                    <td>
                                        {{fullname}}
                                    </td>
                                    <td>
                                        <a href="mailto:{{email}}" class="text-decoration-none">
                                            <i class="fas fa-envelope"></i>
                                            {{email}}
                                        </a>
                                    </td>
                                </tr>
                                {{/unregistered_students}}
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer">
                    <small class="text-muted">
                        <i class="fas fa-info-circle"></i>
                        {{#str}}unregisterednote, mod_pluginpatroller{{/str}}
                    </small>
                </div>
            </div>
        </div>
    </div>
    {{/has_unregistered}}

    {{^has_unregistered}}
    <div class="row">
        <div class="col-12">
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i>
                <strong>{{#str}}excellent, mod_pluginpatroller{{/str}}</strong>
                <p class="mb-0 mt-2">
                    {{#str}}allstudentsregistered, mod_pluginpatroller{{/str}}
                </p>
            </div>
        </div>
    </div>
    {{/has_unregistered}}
</div>

<!-- Scripts de filtros (replicado desde gestion_accesos para asegurar comportamiento idéntico) -->
<script>
function filterTable(tableId) {
    const table = document.getElementById(tableId || '{{table_id}}');
    if (!table) return;
    
    const rows = table.getElementsByTagName('tr');
    let visibleCount = 0;
    
    // Obtener valores de filtros y normalizarlos (trim + uppercase para sede/curso)
    const nameFilter = document.getElementById('filterName')?.value.toLowerCase().trim() || '';
    const sedeFilterRaw = document.getElementById('filterSede')?.value || '';
    const cursoFilterRaw = document.getElementById('filterCurso')?.value || '';
    const sedeFilter = sedeFilterRaw.toString().trim().toUpperCase();
    const cursoFilter = cursoFilterRaw.toString().trim().toUpperCase();
    
    for (let i = 1; i < rows.length; i++) {
        const row = rows[i];
        
    // Obtener datos de la fila desde atributos data- y normalizarlos
    const sede = (row.getAttribute('data-sede') || '').toString().trim().toUpperCase();
    const curso = (row.getAttribute('data-curso') || '').toString().trim().toUpperCase();
        
    // Obtener texto del nombre y apellido (cuarta columna en esta tabla)
    const nameCell = row.getElementsByTagName('td')[3];
    const nameText = nameCell ? nameCell.textContent.toLowerCase().trim() : '';
        
        // Aplicar filtros
    const nameMatch = !nameFilter || nameText.includes(nameFilter);
    // Treat empty or 'ALL' as wildcard
    const sedeMatch = !sedeFilter || sedeFilter === 'ALL' || sede === sedeFilter;
    const cursoMatch = !cursoFilter || cursoFilter === 'ALL' || curso === cursoFilter;
        
        if (nameMatch && sedeMatch && cursoMatch) {
            row.style.display = '';
            visibleCount++;
        } else {
            row.style.display = 'none';
        }
    }
    
    updateFilterCounter(tableId, visibleCount);
}

function clearAllFilters(tableId) {
    const nameFilter = document.getElementById('filterName');
    const sedeFilter = document.getElementById('filterSede');
    const cursoFilter = document.getElementById('filterCurso');
    
    if (nameFilter) nameFilter.value = '';
    // clear selects to empty string which matches the helper-generated options
    if (sedeFilter) sedeFilter.value = '';
    if (cursoFilter) cursoFilter.value = '';
    
    filterTable(tableId);
}

function updateFilterCounter(tableId, visibleCount) {
    const counter = document.getElementById('filterCounter');
    if (counter) {
        const table = document.getElementById(tableId || '{{table_id}}');
        const totalRows = table ? table.getElementsByTagName('tr').length - 1 : 0;
        
        if (visibleCount === totalRows) {
            counter.textContent = `Mostrando todos los ${totalRows} estudiantes`;
        } else {
            counter.textContent = `Mostrando ${visibleCount} de ${totalRows} estudiantes`;
        }
    }
}

document.addEventListener('DOMContentLoaded', function() {
    // Configurar listeners de filtros
    const nameFilter = document.getElementById('filterName');
    if (nameFilter) {
        nameFilter.addEventListener('input', function() { filterTable('{{table_id}}'); });
    }
    const sedeFilter = document.getElementById('filterSede');
    const cursoFilter = document.getElementById('filterCurso');
    if (sedeFilter) sedeFilter.addEventListener('change', function() { filterTable('{{table_id}}'); });
    if (cursoFilter) cursoFilter.addEventListener('change', function() { filterTable('{{table_id}}'); });
    
    // Inicializar contador
    updateFilterCounter('{{table_id}}', document.querySelectorAll('#{{table_id}} tbody tr').length);
});
</script>
