{{!
🔍 FILTROS AVANZADOS REUTILIZABLES
Template para generar filtros consistentes usando FilterHelper
}}

<div class="row mb-3">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-secondary text-white">
                <h6 class="mb-0">
                    <i class="fas fa-filter"></i>
                    Filtros
                </h6>
            </div>
            <div class="card-body py-2">
                <form method="get" action="">
                    <!-- Inputs hidden básicos -->
                    <input type="hidden" name="id" value="{{cm_id}}">
                    <input type="hidden" name="tab" value="tab3">
                    
                    <div class="row align-items-end">
                        {{#filters}}
                        <div class="col-md-3">
                            <label for="{{id}}" class="form-label small mb-1">{{label}}:</label>
                            <select id="{{id}}" name="{{id}}" class="form-control form-control-sm" {{#onchange}}onchange="{{onchange}}"{{/onchange}}>
                                {{#options}}
                                <option value="{{value}}" {{#selected}}selected{{/selected}}>{{text}}</option>
                                {{/options}}
                            </select>
                        </div>
                        {{/filters}}
                        
                        <div class="col-md-3">
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="clearAllFilters('{{table_id}}')">
                                <i class="fas fa-times"></i>
                                Limpiar
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>