{{!
🔑 GESTIÓN DE ACCESOS GITHUB
Maneja invitaciones de GitHub y gestión de repositorios
}}

<!-- 🎨 ENCABEZADO DE PÁGINA -->
<div class="container-fluid mb-4">
    <div class="row">
        <div class="col-12">
            <div class="page-header bg-primary text-white rounded p-3 mb-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h1 class="h3 mb-0">
                            <i class="fas fa-key"></i>
                            Gestión de Accesos GitHub
                        </h1>
                        <p class="mb-0 mt-1 opacity-75">Administra invitaciones y asignaciones de repositorios</p>
                    </div>
                    <div class="text-right">
                        <small class="d-block opacity-75">{{course_name}}</small>
                        {{#user_fullname}}
                        <small class="d-block opacity-75">
                            <i class="fas fa-user"></i> {{user_fullname}}
                        </small>
                        {{/user_fullname}}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">

    <!-- 📧 SECCIÓN INVITACIONES -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-envelope"></i>
                        Procesamiento de Invitaciones GitHub
                    </h5>
                </div>
                <div class="card-body">
                    <form method="get" action="">
                        <input type="hidden" name="id" value="{{cm_id}}">
                        <input type="hidden" name="tab" value="tab2">
                        <input type="hidden" name="send_invitations" value="1">
                        
                        <div class="row align-items-end">
                            <div class="col-md-4">
                                <label for="repository_select" class="form-label font-weight-bold">
                                    <i class="fas fa-code-branch"></i>
                                    Seleccionar Repositorio:
                                </label>
                                <select id="repository_select" name="repository_selected" class="form-control">
                                    {{#repository_options}}
                                    <option value="{{value}}"{{#selected}} selected{{/selected}}>{{text}}</option>
                                    {{/repository_options}}
                                </select>
                            </div>
                            <div class="col-md-6">
                                <button type="submit" class="btn btn-success">
                                    <i class="fas fa-paper-plane"></i>
                                    Enviar Invitaciones
                                </button>
                            </div>
                        </div>
                    </form>
                    <div class="alert alert-info mt-3">
                        <i class="fas fa-info-circle"></i>
                        <strong>Nota:</strong> Solo se enviarán invitaciones a estudiantes con repositorio asignado y usuario GitHub configurado.
                    </div>
                </div>
            </div>
        </div>
    </div>



    {{! FILTROS PARA LA TABLA - SISTEMA MODERNO }}
    {{#filters_config}}
    <div class="row mb-3">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-filter"></i> Filtros de Búsqueda
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        {{#filters}}
                        <div class="col-md-3 mb-2">
                            <label for="{{id}}" class="form-label">{{label}}</label>
                            {{#is_text}}
                                <input type="text" 
                                       id="{{id}}" 
                                       class="form-control form-control-sm" 
                                       placeholder="{{placeholder}}" 
                                       onkeyup="filterTable('{{table_id}}')"
                                       oninput="filterTable('{{table_id}}')">
                            {{/is_text}}
                            {{#is_select}}
                                <select id="{{id}}" class="form-control form-control-sm" onchange="filterTable('{{table_id}}')">
                                    {{#options}}
                                        <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                                    {{/options}}
                                </select>
                            {{/is_select}}
                        </div>
                        {{/filters}}
                        <div class="col-md-3 mb-2 d-flex align-items-end">
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="clearAllFilters('{{table_id}}')">
                                <i class="fas fa-times"></i> Limpiar Filtros
                            </button>
                        </div>
                    </div>
                    <div class="row mt-2">
                        <div class="col-12">
                            <small id="filterCounter" class="text-muted"></small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {{/filters_config}}
    
    {{! FALLBACK: Sistema de filtros antiguo (temporal) }}
    {{^filters_config}}
    {{{filters_html}}}
    {{/filters_config}}

    {{! TABLA DE ESTUDIANTES }}
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="fas fa-users"></i>
                Invitaciones y Registros de GitHub
            </h5>
        </div>
        <div class="card-body">
            {{#has_students}}
            <form method="post" action="">
                <input type="hidden" name="guardar_cambios" value="1">
                <input type="hidden" name="id" value="{{cm_id}}">
                <input type="hidden" name="tab" value="tab2">
                
                <div class="table-responsive">
                    <table class="table table-striped table-hover" id="{{table_id}}">
                        <thead class="thead-dark">
                            <tr>
                                <th><i class="fa fa-user"></i> Usuario</th>
                                <th><i class="fa fa-graduation-cap"></i> Sede</th>
                                <th><i class="fa fa-book"></i> Curso</th>
                                <th><i class="fab fa-github"></i> GitHub</th>
                                <th><i class="fa fa-code-branch"></i> Repositorio</th>
                                <th><i class="fab fa-github"></i> Estado GitHub</th>
                                <th><i class="fa fa-cogs"></i> Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#students}}
                            <tr data-sede="{{sede}}" data-curso="{{curso}}" data-repo="{{repository_name}}">
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-sm bg-primary rounded-circle d-flex align-items-center justify-content-center me-2">
                                            <span class="text-white font-weight-bold">{{initial}}</span>
                                        </div>
                                        <div>
                                            <div class="font-weight-bold">{{full_name}}</div>
                                            <small class="text-muted">{{email}}</small>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge badge-secondary">{{sede}}</span></td>
                                <td><span class="badge badge-info">{{curso}}</span></td>
                                <td>
                                    <div class="form-group mb-0">
                                        <input type="text" 
                                               name="github[{{user_id}}]" 
                                               value="{{github_username}}" 
                                               class="form-control form-control-sm"
                                               placeholder="usuario_github"
                                               {{#readonly_github}}readonly{{/readonly_github}}>
                                    </div>
                                </td>
                                <td>
                                    <div class="form-group mb-0">
                                        <select name="repositorio[{{user_id}}]" class="form-control form-control-sm">
                                            <option value="">Seleccionar...</option>
                                            {{#repository_options}}
                                            <option value="{{value}}" {{#selected}}selected{{/selected}}>{{text}}</option>
                                            {{/repository_options}}
                                        </select>
                                    </div>
                                </td>
                                <td>
                                    {{#github_status_data}}
                                    <span class="badge badge-{{class}}">
                                        <i class="{{icon}}"></i> {{text}}
                                    </span>
                                    {{/github_status_data}}
                                    {{^github_status_data}}
                                    <span class="badge badge-secondary">
                                        <i class="fas fa-question"></i> Sin verificar
                                    </span>
                                    {{/github_status_data}}
                                </td>
                                <td>
                                    {{#has_pending_invitation}}
                                    <form method="post" action="" style="display: inline;">
                                        <input type="hidden" name="cancel_invitation" value="{{user_id}}">
                                        <input type="hidden" name="id" value="{{cm_id}}">
                                        <input type="hidden" name="tab" value="tab2">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" 
                                                onclick="return confirm('¿Está seguro de cancelar la invitación para {{full_name}}?');"
                                                title="Cancelar invitación pendiente">
                                            <i class="fas fa-times"></i> Cancelar
                                        </button>
                                    </form>
                                    {{/has_pending_invitation}}
                                    {{^has_pending_invitation}}
                                    {{#is_collaborator}}
                                    <span class="badge badge-success">
                                        <i class="fas fa-check"></i> Colaborador Activo
                                    </span>
                                    {{/is_collaborator}}
                                    {{^is_collaborator}}
                                    {{#can_invite}}
                                    <form method="post" action="" style="display: inline;">
                                        <input type="hidden" name="send_single_invitation" value="{{user_id}}">
                                        <input type="hidden" name="id" value="{{cm_id}}">
                                        <input type="hidden" name="tab" value="tab2">
                                        <button type="submit" class="btn btn-sm btn-primary" 
                                                onclick="return confirm('¿Enviar invitación de colaboración a {{full_name}}?');"
                                                title="Enviar invitación de colaboración">
                                            <i class="fas fa-paper-plane"></i> Enviar Invitación
                                        </button>
                                    </form>
                                    {{/can_invite}}
                                    {{^can_invite}}
                                    <span class="badge badge-warning">
                                        <i class="fa fa-exclamation"></i> Pendiente
                                    </span>
                                    {{/can_invite}}
                                    {{/is_collaborator}}
                                    {{/has_pending_invitation}}
                                </td>
                            </tr>
                            {{/students}}
                        </tbody>
                    </table>
                </div>
                
                {{#show_save_button}}
                <div class="mt-3">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="fa fa-save"></i> Guardar Cambios
                    </button>
                </div>
                {{/show_save_button}}
            </form>
            {{/has_students}}
            
            {{^has_students}}
            <div class="alert alert-info">
                <i class="fa fa-info-circle"></i>
                <strong>Sin estudiantes:</strong> No hay estudiantes registrados en este curso.
            </div>
            {{/has_students}}
        </div>
    </div>
</div>

{{! FORMULARIO PARA CAMBIO DE REPOSITORIO }}
{{#show_change_repo_form}}
<div class="card mt-4">
    <div class="card-header bg-warning text-dark">
        <h5 class="mb-0">
            <i class="fas fa-exchange-alt"></i> Cambiar Repositorio - {{change_repo_student_name}}
        </h5>
    </div>
    <div class="card-body">
        <form method="post" action="">
            <input type="hidden" name="action" value="change_repository">
            <input type="hidden" name="student_id" value="{{change_repo_student_id}}">
            <input type="hidden" name="id" value="{{cm_id}}">
            <input type="hidden" name="tab" value="tab2">
            
            <div class="row">
                <div class="col-md-8">
                    <div class="form-group">
                        <label for="new_repository_id">Nuevo Repositorio:</label>
                        <select id="new_repository_id" name="new_repository_id" class="form-control" required>
                            <option value="">Seleccionar repositorio...</option>
                            {{#all_repository_options}}
                            <option value="{{value}}">{{text}}</option>
                            {{/all_repository_options}}
                        </select>
                    </div>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <div class="btn-group" role="group">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-exchange-alt"></i> Cambiar Repositorio
                        </button>
                        <a href="?id={{cm_id}}&tab=tab2" class="btn btn-secondary">
                            <i class="fas fa-times"></i> Cancelar
                        </a>
                    </div>
                </div>
            </div>
            
            <div class="alert alert-warning mt-3">
                <i class="fas fa-exclamation-triangle"></i>
                <strong>Atención:</strong> Este cambio resetará el estado de la invitación y el estudiante tendrá que aceptar la nueva invitación.
            </div>
        </form>
    </div>
</div>
{{/show_change_repo_form}}

{{! SCRIPT DE FILTROS }}
<script>
// ==================== FUNCIONES DE FILTRADO ====================
function filterTable(tableId) {
    const table = document.getElementById(tableId || '{{table_id}}');
    if (!table) return;
    
    const rows = table.getElementsByTagName('tr');
    let visibleCount = 0;
    
    // Obtener valores de filtros
    const nameFilter = document.getElementById('filterName')?.value.toLowerCase() || '';
    const sedeFilter = document.getElementById('filterSede')?.value || '';
    const cursoFilter = document.getElementById('filterCurso')?.value || '';
    
    for (let i = 1; i < rows.length; i++) {
        const row = rows[i];
        
        // Obtener datos de la fila
        const sede = row.getAttribute('data-sede') || '';
        const curso = row.getAttribute('data-curso') || '';
        
        // Obtener texto del nombre y apellido (primera columna)
        const nameCell = row.getElementsByTagName('td')[0];
        const nameText = nameCell ? nameCell.textContent.toLowerCase() : '';
        
        // Aplicar filtros
        const nameMatch = !nameFilter || nameText.includes(nameFilter);
        const sedeMatch = !sedeFilter || sedeFilter === 'all' || sede === sedeFilter;
        const cursoMatch = !cursoFilter || cursoFilter === 'all' || curso === cursoFilter;
        
        // Mostrar/ocultar fila
        if (nameMatch && sedeMatch && cursoMatch) {
            row.style.display = '';
            visibleCount++;
        } else {
            row.style.display = 'none';
        }
    }
    
    // Actualizar contador
    updateFilterCounter(tableId, visibleCount);
}

function clearAllFilters(tableId) {
    // Limpiar campos de filtro
    const nameFilter = document.getElementById('filterName');
    const sedeFilter = document.getElementById('filterSede');
    const cursoFilter = document.getElementById('filterCurso');
    
    if (nameFilter) nameFilter.value = '';
    if (sedeFilter) sedeFilter.value = 'all';
    if (cursoFilter) cursoFilter.value = 'all';
    
    // Aplicar filtros (mostrar todo)
    filterTable(tableId);
}

function updateFilterCounter(tableId, visibleCount) {
    const counter = document.getElementById('filterCounter');
    if (counter) {
        const table = document.getElementById(tableId || '{{table_id}}');
        const totalRows = table ? table.getElementsByTagName('tr').length - 1 : 0; // -1 para excluir header
        
        if (visibleCount === totalRows) {
            counter.textContent = `Mostrando todos los ${totalRows} estudiantes`;
        } else {
            counter.textContent = `Mostrando ${visibleCount} de ${totalRows} estudiantes`;
        }
    }
}

// ==================== INICIALIZACIÓN ====================
document.addEventListener('DOMContentLoaded', function() {
    console.log('Sistema de filtros para gestión de accesos cargado correctamente');
    
    // Configurar búsqueda en tiempo real para el campo nombre
    const nameFilter = document.getElementById('filterName');
    if (nameFilter) {
        nameFilter.addEventListener('input', function() {
            filterTable('{{table_id}}');
        });
        console.log('Filtro de nombre configurado para búsqueda en tiempo real');
    }
    
    // Configurar filtros de select
    const sedeFilter = document.getElementById('filterSede');
    const cursoFilter = document.getElementById('filterCurso');
    
    if (sedeFilter) {
        sedeFilter.addEventListener('change', function() {
            filterTable('{{table_id}}');
        });
    }
    
    if (cursoFilter) {
        cursoFilter.addEventListener('change', function() {
            filterTable('{{table_id}}');
        });
    }
    
    // Inicializar contador de filtros
    updateFilterCounter('{{table_id}}', document.querySelectorAll('#{{table_id}} tbody tr').length);
});

// ==================== FUNCIONES DE INVITACIONES ====================
function confirmSendInvitation(studentId, studentName) {
    return confirm(`¿Estás seguro de enviar una invitación a ${studentName}?`);
}

function confirmCancelInvitation(studentId, studentName) {
    return confirm(`¿Estás seguro de cancelar la invitación de ${studentName}?`);
}
</script>