{{!
 GITHUB ACCESS MANAGEMENT
Handles GitHub repository invitations and administration
}}

<!-- PAGE HEADER -->
<div class="container-fluid mb-4">
    <div class="row">
        <div class="col-12">
            <div class="page-header bg-primary text-white rounded p-3 mb-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h1 class="h3 mb-0">
                            <i class="fas fa-key"></i>
                            {{#str}}accessmanagement, mod_pluginpatroller{{/str}}
                        </h1>
                        <p class="mb-0 mt-1 opacity-75">{{#str}}manageinvitationsrepos, mod_pluginpatroller{{/str}}</p>
                    </div>
                    <div class="text-right">
                        <small class="d-block opacity-75">{{course_name}}</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">

    <!--  INVITATIONS SECTION -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-envelope"></i>
                        {{#str}}githubprocessing, mod_pluginpatroller{{/str}}
                    </h5>
                </div>
                <div class="card-body">
                    <form method="get" action="" id="invitations-form">
                        <input type="hidden" name="id" value="{{cm_id}}">
                        <input type="hidden" name="tab" value="tab2">
                        <input type="hidden" name="send_invitations" value="1">
                        
                        <div class="row align-items-end">
                            <div class="col-md-4">
                                <label for="repository_select" class="form-label font-weight-bold">
                                    <i class="fas fa-code-branch"></i>
                                    {{#str}}selectrepository, mod_pluginpatroller{{/str}}
                                </label>
                                <select id="repository_select" name="repository_selected" class="form-control">
                                    {{#repository_options}}
                                    <option value="{{value}}"{{#selected}} selected{{/selected}}>{{text}}</option>
                                    {{/repository_options}}
                                </select>
                            </div>
                            <div class="col-md-6">
                                <button type="submit" class="btn btn-success" id="send-invitations-btn">
                                    <i class="fas fa-paper-plane"></i>
                                    {{#str}}sendinvitations, mod_pluginpatroller{{/str}}
                                </button>
                            </div>
                        </div>
                    </form>
                    <div class="alert alert-info mt-3">
                        <i class="fas fa-info-circle"></i>
                        <strong>{{#str}}note, mod_pluginpatroller{{/str}}</strong> {{#str}}invitationsnote, mod_pluginpatroller{{/str}}
                    </div>
                </div>
            </div>
        </div>
    </div>



    {{! CONFIGURACI├ôN PARA JAVASCRIPT EXTERNO }}
    <script>
    // Configuraci├│n global para el m├│dulo de gesti├│n de accesos
    window.GestionAccesosConfig = {
        cmId: '{{cm_id}}',
        sesskey: '{{sesskey}}',
        baseUrl: window.location.href,
        tableId: '{{table_id}}',
        debug: {{#debugging}}true{{/debugging}}{{^debugging}}false{{/debugging}},
        strings: {
            syncing: '{{#str}}syncing, mod_pluginpatroller{{/str}}',
            syncStates: '{{#str}}synchronizestatus, mod_pluginpatroller{{/str}}',
            success: '{{#str}}syncsuccess, mod_pluginpatroller{{/str}}',
            errorServer: '{{#str}}errorserver, mod_pluginpatroller{{/str}}',
            errorSync: '{{#str}}errorsync, mod_pluginpatroller{{/str}}',
            completed: '{{#str}}synccompleted, mod_pluginpatroller{{/str}}'
        }
    };
    </script>

    {{! FILTROS PARA LA TABLA - SISTEMA MODERNO }}
    {{#filters_config}}
    <div class="row mb-3">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-filter"></i> Filtros de Busqueda
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        {{#filters}}
                        <div class="col-md-3 mb-2">
                            <label for="{{id}}" class="form-label">{{label}}</label>
                            {{#is_text}}
                                <input type="text" 
                                       id="{{id}}" 
                                       class="form-control form-control-sm" 
                                       placeholder="{{placeholder}}" 
                                       onkeyup="filterTable('{{table_id}}')"
                                       oninput="filterTable('{{table_id}}')">
                            {{/is_text}}
                            {{#is_select}}
                                <select id="{{id}}" class="form-control form-control-sm" onchange="filterTable('{{table_id}}')">
                                    {{#options}}
                                        <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                                    {{/options}}
                                </select>
                            {{/is_select}}
                        </div>
                        {{/filters}}
                        <div class="col-md-3 mb-2 d-flex align-items-end">
                            <button type="button" id="clearFilters" class="btn btn-outline-secondary btn-sm" onclick="clearAllFilters()">
                                <i class="fas fa-times"></i> {{#str}}clearfilters, mod_pluginpatroller{{/str}}
                            </button>
                        </div>
                    </div>
                    <div class="row mt-2">
                        <div class="col-12">
                            <small id="filterCounter" class="text-muted"></small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {{/filters_config}}

    {{! TABLA DE ESTUDIANTES }}
    <div class="card">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="fas fa-users"></i>
                {{#str}}invitationsregisters, mod_pluginpatroller{{/str}}
            </h5>
            <div class="d-flex align-items-center">
                <button id="sync-btn" class="btn btn-light btn-sm" 
                        onclick="syncInvitationStates()"
                        title="{{#str}}synchronizestatus, mod_pluginpatroller{{/str}} - {{#str}}detectchangesinvitations, mod_pluginpatroller{{/str}}">
                    <i id="sync-icon" class="fas fa-sync-alt"></i> <span id="sync-text">{{#str}}synchronizestatus, mod_pluginpatroller{{/str}}</span>
                </button>
                <div id="sync-progress" class="ml-2" style="display: none;">
                    <small class="text-info">
                        <i class="fas fa-spinner fa-spin"></i> 
                        <span id="sync-status">Iniciando...</span>
                    </small>
                </div>
            </div>
        </div>
        <div class="card-body">
            {{#has_students}}
            <form method="post" action="">
                <input type="hidden" name="guardar_cambios" value="1">
                <input type="hidden" name="id" value="{{cm_id}}">
                <input type="hidden" name="tab" value="tab2">
                
                <div class="table-responsive">
                    <table class="table table-striped table-hover" id="{{table_id}}">
                        <thead class="thead-dark">
                            <tr>
                                <th><i class="fa fa-user"></i> {{#str}}user, mod_pluginpatroller{{/str}}</th>
                                <th><i class="fa fa-graduation-cap"></i> {{#str}}sede, mod_pluginpatroller{{/str}}</th>
                                <th><i class="fa fa-book"></i> {{#str}}course, mod_pluginpatroller{{/str}}</th>
                                <th><i class="fab fa-github"></i> GitHub</th>
                                <th><i class="fa fa-code-branch"></i> {{#str}}repository, mod_pluginpatroller{{/str}}</th>
                                <th><i class="fa fa-envelope"></i> {{#str}}invitationstatus, mod_pluginpatroller{{/str}}</th>
                                <th><i class="fa fa-cogs"></i> {{#str}}actions, mod_pluginpatroller{{/str}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#students}}
                            <tr data-sede="{{sede}}" data-curso="{{curso}}" data-repo="{{repository_name}}">
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-sm bg-primary rounded-circle d-flex align-items-center justify-content-center me-2">
                                            <span class="text-white font-weight-bold">{{initial}}</span>
                                        </div>
                                        <div>
                                            <div class="font-weight-bold">{{full_name}}</div>
                                            <small class="text-muted">{{email}}</small>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge badge-secondary">{{sede}}</span></td>
                                <td><span class="badge badge-info">{{curso}}</span></td>
                                <td>
                                    {{#github_username}}
                                        <div class="d-flex align-items-center">
                                            <i class="fab fa-github text-muted mr-1"></i>
                                            <strong>{{github_username}}</strong>
                                        </div>
                                    {{/github_username}}
                                    {{^github_username}}
                                        <span class="text-muted">
                                            <i class="fas fa-minus-circle"></i> {{#str}}unassigned, mod_pluginpatroller{{/str}}
                                        </span>
                                    {{/github_username}}
                                </td>
                                <td>
                                    {{#repository_name}}
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-code-branch text-muted mr-1"></i>
                                            <strong>{{repository_name}}</strong>
                                        </div>
                                    {{/repository_name}}
                                    {{^repository_name}}
                                        <span class="text-muted">
                                            <i class="fas fa-minus-circle"></i> {{#str}}unassigned, mod_pluginpatroller{{/str}}
                                        </span>
                                    {{/repository_name}}
                                </td>
                                <td class="align-top">
                                    {{#github_status_data}}
                                    <span class="badge badge-{{class}}">
                                        <i class="{{icon}}"></i> {{text}}
                                    </span>
                                    {{/github_status_data}}
                                    {{^github_status_data}}
                                    <span class="badge badge-secondary">
                                        <i class="fas fa-question"></i> {{#str}}unverified, mod_pluginpatroller{{/str}}
                                    </span>
                                    {{/github_status_data}}
                                </td>
                                <td class="align-top">
                                    <div class="d-flex flex-column" style="gap: 3px;">
                                        <!-- Bot├│n cambiar repo (siempre visible si tiene repo asignado) -->
                                        {{#repository_name}}
                                        <a href="?id={{cm_id}}&tab=tab2&change_repo_for={{user_id}}" 
                                           class="badge badge-secondary text-decoration-none" 
                                           style="cursor: pointer; width: fit-content;"
                                           title="{{#str}}changerepository, mod_pluginpatroller{{/str}}">
                                            <i class="fas fa-exchange-alt"></i> {{#str}}change, mod_pluginpatroller{{/str}}
                                        </a>
                                        {{/repository_name}}
                                        
                                        <!-- Botones de invitaci├│n (solo si NO es colaborador activo) -->
                                        {{^is_collaborator}}
                                            {{#has_pending_invitation}}
                                            <form method="post" action="" class="m-0" style="width: fit-content;">
                                                <input type="hidden" name="cancel_invitation" value="{{user_id}}">
                                                <input type="hidden" name="id" value="{{cm_id}}">
                                                <input type="hidden" name="tab" value="tab2">
                                                <button type="submit" class="badge badge-danger border-0" 
                                                        style="cursor: pointer; width: fit-content;"
                                                        onclick="return confirm('{{#str}}confirmcancelinvitation, mod_pluginpatroller, {{full_name}}{{/str}}');"
                                                        title="{{#str}}cancelinvitationpending, mod_pluginpatroller{{/str}}">
                                                    <i class="fas fa-times"></i> {{#str}}cancel, mod_pluginpatroller{{/str}}
                                                </button>
                                            </form>
                                            {{/has_pending_invitation}}
                                            
                                            {{^has_pending_invitation}}
                                                {{#can_invite}}
                                                <form method="post" action="" class="m-0" style="width: fit-content;">
                                                    <input type="hidden" name="send_single_invitation" value="{{user_id}}">
                                                    <input type="hidden" name="id" value="{{cm_id}}">
                                                    <input type="hidden" name="tab" value="tab2">
                                                    <button type="submit" class="badge badge-primary border-0" 
                                                            style="cursor: pointer; width: fit-content;"
                                                            onclick="return confirm('{{#str}}confirmsendinvitation, mod_pluginpatroller, {{full_name}}{{/str}}');"
                                                            title="{{#str}}sendinvitationcollaboration, mod_pluginpatroller{{/str}}">
                                                        <i class="fas fa-paper-plane"></i> {{#str}}send, mod_pluginpatroller{{/str}}
                                                    </button>
                                                </form>
                                                {{/can_invite}}
                                                
                                                {{^can_invite}}
                                                <span class="badge badge-warning">
                                                    <i class="fa fa-exclamation"></i> {{#str}}incomplete, mod_pluginpatroller{{/str}}
                                                </span>
                                                {{/can_invite}}
                                            {{/has_pending_invitation}}
                                        {{/is_collaborator}}
                                    </div>
                                </td>
                            </tr>
                            
                            <!-- Fila expandida para cambiar repositorio -->
                            {{#show_change_form}}
                            <tr class="bg-light">
                                <td colspan="7">
                                    <div class="card border-primary">
                                        <div class="card-header bg-primary text-white">
                                            <h6 class="mb-0">
                                                <i class="fas fa-exchange-alt"></i> {{#str}}changerepositoryfor, mod_pluginpatroller{{/str}} {{full_name}}
                                            </h6>
                                        </div>
                                        <div class="card-body">
                                            <form method="post" action="">
                                                <input type="hidden" name="id" value="{{cm_id}}">
                                                <input type="hidden" name="tab" value="tab2">
                                                <input type="hidden" name="change_repo_user_id" value="{{user_id}}">
                                                
                                                <div class="row">
                                                    <div class="col-md-6">
                                                        <p><strong>{{#str}}student, mod_pluginpatroller{{/str}}:</strong> {{full_name}}</p>
                                                        <p><strong>{{#str}}githubuser, mod_pluginpatroller{{/str}}:</strong> {{github_username}}</p>
                                                        <p><strong>{{#str}}currentrepository, mod_pluginpatroller{{/str}}:</strong> <span class="badge badge-info">{{repository_name}}</span></p>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <div class="form-group">
                                                            <label for="new_repo_name"><strong>{{#str}}newrepository, mod_pluginpatroller{{/str}}:</strong></label>
                                                            <select name="new_repo_name" id="new_repo_name" class="form-control" required>
                                                                <option value="">-- {{#str}}selectrepository, mod_pluginpatroller{{/str}} --</option>
                                                                {{#available_repos}}
                                                                <option value="{{value}}">{{text}}</option>
                                                                {{/available_repos}}
                                                            </select>
                                                        </div>
                                                    </div>
                                                </div>
                                                
                                                <div class="text-right">
                                                    <a href="?id={{cm_id}}&tab=tab2" class="btn btn-secondary">
                                                        <i class="fas fa-times"></i> {{#str}}cancel, mod_pluginpatroller{{/str}}
                                                    </a>
                                                    <button type="submit" class="btn btn-primary">
                                                        <i class="fas fa-check"></i> {{#str}}confirmchange, mod_pluginpatroller{{/str}}
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            {{/show_change_form}}
                            {{/students}}
                        </tbody>
                    </table>
                </div>
            </form>
            {{/has_students}}
            
            {{^has_students}}
            <div class="alert alert-info">
                <i class="fa fa-info-circle"></i>
                <strong>{{#str}}nostudents, mod_pluginpatroller{{/str}}</strong> {{#str}}nostudentsregistered, mod_pluginpatroller{{/str}}
            </div>
            {{/has_students}}
        </div>
    </div>
</div>
