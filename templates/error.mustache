{{!
🚨 TEMPLATE DE ERROR UNIFICADO
Manejo consistente de errores en todo el plugin
}}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-exclamation-triangle fa-2x mr-3"></i>
                        <div>
                            <h4 class="mb-0">{{error_title}}</h4>
                            <small class="opacity-75">Ha ocurrido un problema</small>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="alert alert-danger border-0">
                        <div class="d-flex">
                            <i class="fas fa-bug fa-lg mr-3 mt-1"></i>
                            <div>
                                <h6 class="font-weight-bold">Detalles del error:</h6>
                                <p class="mb-0">{{error_message}}</p>
                            </div>
                        </div>
                    </div>
                    
                    <hr>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <h6><i class="fas fa-question-circle"></i> ¿Qué puedes hacer?</h6>
                            <ul class="small">
                                <li>Refresca la página y vuelve a intentar</li>
                                <li>Verifica que tienes los permisos necesarios</li>
                                <li>Contacta al administrador si persiste</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h6><i class="fas fa-info-circle"></i> Información técnica:</h6>
                            <p class="small text-muted">
                                <strong>Curso:</strong> {{course_name}}<br>
                                <strong>Usuario:</strong> {{user_fullname}}<br>
                                <strong>Timestamp:</strong> <span id="errorTime"></span>
                            </p>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-light">
                    <div class="text-center">
                        <button onclick="history.back()" class="btn btn-secondary mr-2">
                            <i class="fas fa-arrow-left"></i>
                            Volver
                        </button>
                        <button onclick="location.reload()" class="btn btn-primary">
                            <i class="fas fa-sync-alt"></i>
                            Recargar Página
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
// Mostrar timestamp del error
document.addEventListener('DOMContentLoaded', function() {
    document.getElementById('errorTime').textContent = new Date().toLocaleString();
});
</script>
