{{!
🎨 COMPONENTE: Encabezado de página consistente
Usado por todos los templates principales
}}

<div class="container-fluid mb-4">
    <div class="row">
        <div class="col-12">
            <div class="page-header bg-primary text-white rounded p-3 mb-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h1 class="h3 mb-0">
                            <i class="{{header_icon}}"></i>
                            {{header_title}}
                        </h1>
                        {{#header_subtitle}}
                        <p class="mb-0 mt-1 opacity-75">{{header_subtitle}}</p>
                        {{/header_subtitle}}
                    </div>
                    <div class="text-right">
                        <small class="d-block opacity-75">{{course_name}}</small>
                        {{#user_fullname}}
                        <small class="d-block opacity-75">
                            <i class="fas fa-user"></i> {{user_fullname}}
                        </small>
                        {{/user_fullname}}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
