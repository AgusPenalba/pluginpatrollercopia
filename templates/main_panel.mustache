{{!
🏠 MAIN PANEL - REPOSITORY MANAGEMENT
Main panel for teachers - GitHub repository creation and management
}}

<!-- PAGE HEADER -->
<div class="container-fluid mb-4">
    <div class="row">
        <div class="col-12">
            <div class="page-header bg-primary text-white rounded p-3 mb-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h1 class="h3 mb-0">
                            <i class="{{header_icon}}"></i>
                            {{header_title}}
                        </h1>
                        {{#header_subtitle}}
                        <p class="mb-0 mt-1 opacity-75">{{header_subtitle}}</p>
                        {{/header_subtitle}}
                    </div>
                    <div class="text-right">
                        <small class="d-block opacity-75">{{course_name}}</small>
                        {{#user_fullname}}
                        <small class="d-block opacity-75">
                            <i class="fas fa-user"></i> {{user_fullname}}
                        </small>
                        {{/user_fullname}}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <!-- ALERT MESSAGES -->
    {{#success_message}}
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i>
        <strong>{{#str}}success, mod_pluginpatroller{{/str}}</strong> {{success_message}}
        <button type="button" class="close" data-dismiss="alert" aria-label="{{#str}}close, mod_pluginpatroller{{/str}}">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
    {{/success_message}}

    {{#error_message}}
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle"></i>
        <strong>{{#str}}error, mod_pluginpatroller{{/str}}</strong> {{error_message}}
        <button type="button" class="close" data-dismiss="alert" aria-label="{{#str}}close, mod_pluginpatroller{{/str}}">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
    {{/error_message}}

    <!-- 📊 COURSE INFORMATION -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-info-circle"></i>
                        {{#str}}courseinfo, mod_pluginpatroller{{/str}}
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped mb-0">
