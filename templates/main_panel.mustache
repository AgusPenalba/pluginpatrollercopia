<!-- JavaScript para habilitar/deshabilitar selectors -->
<script>
function toggleSelect(checkbox) {
    var groupKey = checkbox.value;
    var selectElement = document.getElementById("select-" + groupKey);
    if (selectElement) {
        selectElement.disabled = !checkbox.checked;
    }
}
</script>

<style>
/* Estilos para la tabla matricial compacta */
.table-compact {
    font-size: 0.9em;
}

/* Headers gris claro */
.thead-dark th {
    background-color: #e9ecef !important;
    border-color: #dee2e6 !important;
    color: #495057 !important;
}

.sede-column {
    width: 80px;
    min-width: 80px;
    max-width: 80px;
    white-space: nowrap;
    font-size: 0.85em;
}

.curso-column {
    width: 200px;
    min-width: 180px;
}

.sede-name {
    font-size: 0.85em;
    padding: 8px 6px;
}

.curso-cell {
    padding: 6px 8px;
    vertical-align: middle;
}

.pending-content, .no-pending-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
}

.pending-text {
    margin-bottom: 2px;
}

.controls-inline {
    display: flex;
    align-items: center;
    gap: 6px;
    width: 100%;
}

.inline-select {
    flex: 1;
    min-width: 80px;
    max-width: 140px;
    font-size: 0.8em;
}

.no-pending-content {
    flex-direction: row;
    align-items: center;
    gap: 8px;
}

.no-pending-content .inline-select {
    min-width: 80px;
}

.badge {
    font-size: 0.8em;
    min-width: 20px;
}

.table th {
    white-space: nowrap;
}

/* Hacer checkboxes más pequeños */
.form-check-input {
    transform: scale(0.9);
}
</style>

{{#filter_script}}
<script>
{{{filter_script}}}
</script>
{{/filter_script}}