{{!
🏠 MAIN PANEL - GESTIÓN DE REPOSITORIOS
Panel principal para profesores - creación y gestión de repositorios GitHub
}}

<!-- HEADER DE PÁGINA -->
<div class="container-fluid mb-4">
    <div class="row">
        <div class="col-12">
            <div class="page-header bg-primary text-white rounded p-3 mb-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h1 class="h3 mb-0">
                            <i class="{{header_icon}}"></i>
                            {{header_title}}
                        </h1>
                        {{#header_subtitle}}
                        <p class="mb-0 mt-1 opacity-75">{{header_subtitle}}</p>
                        {{/header_subtitle}}
                    </div>
                    <div class="text-right">
                        <small class="d-block opacity-75">{{course_name}}</small>
                        {{#user_fullname}}
                        <small class="d-block opacity-75">
                            <i class="fas fa-user"></i> {{user_fullname}}
                        </small>
                        {{/user_fullname}}
                    </div>
                </div>
            </div>
            
            <!-- MENSAJE DE ÉXITO -->
            {{#success_message}}
            <div class="alert alert-success alert-dismissible fade show" role="alert" id="success-alert">
                <i class="fas fa-check-circle"></i>
                <strong>¡Éxito!</strong> {{success_message}}
                <button type="button" class="close" onclick="document.getElementById('success-alert').style.display='none'" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            {{/success_message}}
        </div>
    </div>
</div>

<div class="container-fluid">
    <!-- MENSAJES DE ALERTA -->
    {{#error_message}}
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle"></i>
        <strong>Error:</strong> {{error_message}}
        <button type="button" class="close" data-dismiss="alert" aria-label="Cerrar">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
    {{/error_message}}

    <!-- 📊 INFORMACIÓN DEL CURSO -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-info-circle"></i>
                        Información del Curso
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped mb-0">
                            <thead class="thead-light">
                                <tr>
                                    <th scope="col">Materia</th>
                                    <th scope="col">Año</th>
                                    <th scope="col">Cuatrimestre</th>
                                    <th scope="col">Grupos que necesitan repos</th>
                                    <th scope="col">Max. Alumnos / Repo</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#course_info}}
                                <tr>
                                    <td><strong>{{shortname}}</strong></td>
                                    <td>{{year}}</td>
                                    <td>{{semester}}</td>
                                    <td>
                                        {{#total_pending}}
                                        <span class="badge badge-warning">
                                            {{total_pending}} repos
                                        </span>
                                        {{/total_pending}}
                                        {{^total_pending}}
                                        <span class="badge badge-success">
                                            <i class="fas fa-check"></i> Completo
                                        </span>
                                        {{/total_pending}}
                                    </td>
                                    <td>{{max_students_per_repo}}</td>
                                </tr>
                                {{/course_info}}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>



    <!-- 👥 TABLA MATRICIAL DE ALUMNOS PENDIENTES -->
    {{#has_pending_groups}}
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-users"></i>
                        Alumnos pendientes por Sede y Curso
                    </h5>
                </div>
                <div class="card-body">
                    <form method="post" action="" id="repoForm">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <input type="hidden" name="id" value="{{cm_id}}">
                        
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover table-compact">
                                <thead class="thead-dark">
                                    <tr>
                                        <th scope="col" class="sede-column">Sede\Curso</th>
                                        {{#course_letters}}
                                        <th scope="col" class="text-center curso-column">{{.}}</th>
                                        {{/course_letters}}
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#sedes}}
                                    <tr>
                                        <th scope="row" class="bg-light sede-name">{{sede_name}}</th>
                                        {{#courses}}
                                        <td class="curso-cell">
                                            {{#has_pending}}
                                            <div class="pending-content">
                                                <div class="controls-inline">
                                                    <input type="checkbox" class="form-check-input mr-2" 
                                                           name="selected_groups[]" 
                                                           value="{{group_key}}" 
                                                           id="check-{{group_key}}"
                                                           onclick="toggleSelect(this)">
                                                    <select class="form-control form-control-sm inline-select" 
                                                            name="repos_to_add[{{group_key}}]" 
                                                            id="select-{{group_key}}" 
                                                            disabled>
                                                        {{#repo_options}}
                                                        <option value="{{value}}">{{text}}</option>
                                                        {{/repo_options}}
                                                    </select>
                                                </div>
                                            </div>
                                            {{/has_pending}}
                                            {{^has_pending}}
                                            <div class="no-pending-content">
                                                <small class="text-success mr-2">
                                                    <i class="fas fa-check-circle"></i>
                                                    Completo
                                                </small>
                                                <input type="checkbox" class="form-check-input mr-2" disabled>
                                                <select class="form-control form-control-sm inline-select" disabled>
                                                    <option>Sin necesidades</option>
                                                </select>
                                            </div>
                                            {{/has_pending}}
                                        </td>
                                        {{/courses}}
                                    </tr>
                                    {{/sedes}}
                                </tbody>
                            </table>
                        </div>
                        
                        <div class="text-right mt-3">
                            <button type="submit" name="create_repos_submit" value="1" class="btn btn-success">
                                <i class="fas fa-plus-circle"></i>
                                Crear Repositorios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    {{/has_pending_groups}}

    <!-- � TABLA DE REPOSITORIOS CREADOS -->
    {{#has_created_repos}}
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="fas fa-code-branch"></i>
                            Repositorios Creados
                        </h5>
                        <small class="opacity-75">
                            <i class="fas fa-info-circle"></i>
                            Eliminar libera estudiantes automáticamente
                        </small>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0">
                            <thead class="thead-light">
                                <tr>
                                    <th scope="col">Sede</th>
                                    <th scope="col">Curso</th>
                                    <th scope="col">Nro Grupo</th>
                                    <th scope="col">Repositorio</th>
                                    <th scope="col" title="Cantidad de miembros en el grupo">
                                        <i class="fas fa-users"></i> Miembros
                                    </th>
                                    <th scope="col" title="Alumnos que ya aceptaron la invitación">
                                        <i class="fas fa-check-circle"></i> Activos
                                    </th>
                                    <th scope="col" title="Alumnos que fueron invitados pero que todavía no aceptaron la invitación">
                                        <i class="fas fa-clock"></i> Pendientes
                                    </th>
                                    <th scope="col" title="Alumnos cuyo nombre de usuario en GitHub no fue encontrado">
                                        <i class="fas fa-user-times"></i> No encontrados
                                    </th>
                                    <th scope="col" title="Alumnos cuyo nombre de usuario en GitHub no fue cargado">
                                        <i class="fas fa-edit"></i> Sin completar
                                    </th>
                                    <th scope="col" title="Alumnos sin procesar">
                                        <i class="fas fa-pause-circle"></i> Sin procesar
                                    </th>
                                    <th scope="col" title="Alumnos procesados con error">
                                        <i class="fas fa-exclamation-triangle"></i> Con Error
                                    </th>
                                    <th scope="col" class="text-center">
                                        <i class="fas fa-cogs"></i> Acciones
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#created_repos}}
                                <tr>
                                    <td>{{sede}}</td>
                                    <td>{{curso}}</td>
                                    <td>{{nro}}</td>
                                    <td>
                                        {{#repository_url}}
                                            <a href="{{repository_url}}" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary">
                                                <i class="fab fa-github"></i>
                                                <span class="ml-1">{{nombre_repo}}</span>
                                            </a>
                                        {{/repository_url}}
                                        {{^repository_url}}
                                            <strong>{{nombre_repo}}</strong>
                                        {{/repository_url}}
                                    </td>
                                    <td>
                                        <span class="badge badge-secondary">{{total_members}}</span>
                                    </td>
                                    <td>
                                        <span class="badge badge-light">{{accepted}}</span>
                                    </td>
                                    <td>
                                        <span class="badge badge-light">{{pending}}</span>
                                    </td>
                                    <td>
                                        <span class="badge badge-light">{{not_found}}</span>
                                    </td>
                                    <td>
                                        <span class="badge badge-light">{{missing_username}}</span>
                                    </td>
                                    <td>
                                        <span class="badge badge-light">{{unprocessed}}</span>
                                    </td>
                                    <td>
                                        <span class="badge badge-light">{{error}}</span>
                                    </td>
                                    <td class="text-center">
                                        <form method="post" action="" style="display: inline;" 
                                              onsubmit="return confirmDelete('{{nombre_repo}}', '{{sede}}', '{{curso}}', {{total_members}})">
                                            <input type="hidden" name="sesskey" value="{{sesskey}}">
                                            <input type="hidden" name="id" value="{{cm_id}}">
                                            <input type="hidden" name="delete_repo_id" value="{{repo_id}}">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" 
                                                    title="Eliminar repositorio {{nombre_repo}} ({{total_members}} miembros)">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                                {{/created_repos}}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {{/has_created_repos}}

    {{^has_created_repos}}
    <div class="row">
        <div class="col-12">
            <div class="alert alert-info text-center">
                <i class="fas fa-info-circle fa-2x mb-3"></i>
                <h5>No hay repositorios creados aún</h5>
                <p class="mb-0">Cuando crees repositorios, aparecerán aquí con sus estadísticas detalladas.</p>
            </div>
        </div>
    </div>
    {{/has_created_repos}}
</div>

<!-- JavaScript para habilitar/deshabilitar selectors -->
<script>
function toggleSelect(checkbox) {
    var groupKey = checkbox.value;
    var selectElement = document.getElementById("select-" + groupKey);
    if (selectElement) {
        selectElement.disabled = !checkbox.checked;
    }
}
</script>

<style>
/* Estilos para la tabla matricial compacta */
.table-compact {
    font-size: 0.9em;
}

/* Headers gris claro */
.thead-dark th {
    background-color: #e9ecef !important;
    border-color: #dee2e6 !important;
    color: #495057 !important;
}

.sede-column {
    width: 80px;
    min-width: 80px;
    max-width: 80px;
    white-space: nowrap;
    font-size: 0.85em;
}

.curso-column {
    width: 200px;
    min-width: 180px;
}

.sede-name {
    font-size: 0.85em;
    padding: 8px 6px;
}

.curso-cell {
    padding: 6px 8px;
    vertical-align: middle;
}

.pending-content, .no-pending-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
}

.pending-text {
    margin-bottom: 2px;
}

.controls-inline {
    display: flex;
    align-items: center;
    gap: 6px;
    width: 100%;
}

.inline-select {
    flex: 1;
    min-width: 80px;
    max-width: 140px;
    font-size: 0.8em;
}

.no-pending-content {
    flex-direction: row;
    align-items: center;
    gap: 8px;
}

.no-pending-content .inline-select {
    min-width: 80px;
}

.badge {
    font-size: 0.8em;
    min-width: 20px;
}

.table th {
    white-space: nowrap;
}

/* Hacer checkboxes más pequeños */
.form-check-input {
    transform: scale(0.9);
}
</style>

<script>
function confirmDelete(repoName, sede, curso, members) {
    var memberText = members == 1 ? 'estudiante' : 'estudiantes';
    var message = '⚠️ CONFIRMAR ELIMINACIÓN DE REPOSITORIO\n\n' +
                  '📁 Repositorio: ' + repoName + '\n' +
                  '🏫 Sede: ' + sede + ' - Curso: ' + curso + '\n' +
                  '👥 Miembros afectados: ' + members + ' ' + memberText + '\n\n' +
                  '¿Está seguro de continuar?\n\n' +
                  '✓ El repositorio será eliminado de GitHub\n' +
                  '✓ Se eliminará de la base de datos\n' +
                  '✓ Los ' + members + ' ' + memberText + ' serán liberados\n' +
                  '✓ Deberá recrear el repositorio si lo necesita';
    
    return confirm(message);
}
</script>