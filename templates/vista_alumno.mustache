{{!
🎓 VISTA DE ESTUDIANTE
Ver compañeros de curso y gestionar repositorio asignado
}}

<!-- 🎨 ENCABEZADO DE PÁGINA -->
<div class="container-fluid mb-4">
    <div class="row">
        <div class="col-12">
            <div class="page-header bg-primary text-white rounded p-3 mb-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h1 class="h3 mb-0">
                            <i class="fas fa-users"></i>
                            {{#str}}classmates, mod_pluginpatroller{{/str}}
                        </h1>
                        <p class="mb-0 mt-1 opacity-75">{{#str}}academicgroupinfo, mod_pluginpatroller{{/str}}</p>
                    </div>
                    <div class="text-right">
                        <small class="d-block opacity-75">{{course_name}}</small>
                        {{#user_fullname}}
                        <small class="d-block opacity-75">
                            <i class="fas fa-user"></i> {{user_fullname}}
                        </small>
                        {{/user_fullname}}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <!-- MENSAJES DE ALERTA -->
    {{#success_message}}
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i>
        <strong>{{#str}}success, mod_pluginpatroller{{/str}}</strong> {{success_message}}
        <button type="button" class="close" data-dismiss="alert" aria-label="{{#str}}close, mod_pluginpatroller{{/str}}">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
    {{/success_message}}

    {{#error_message}}
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle"></i>
        <strong>{{#str}}error, mod_pluginpatroller{{/str}}</strong> {{error_message}}
        <button type="button" class="close" data-dismiss="alert" aria-label="{{#str}}close, mod_pluginpatroller{{/str}}">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
    {{/error_message}}

    <div class="row mb-3">
        <div class="col-12">
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i>
                <strong>{{#str}}youracademiccontext, mod_pluginpatroller{{/str}}</strong> {{my_sede_curso}}
            </div>
        </div>
    </div>

    <!-- 🔍 SECCIÓN FILTROS -->
    {{#has_classmates}}
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-filter"></i> {{#str}}searchfilters, mod_pluginpatroller{{/str}}
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        {{#filters}}
                        <div class="col-md-4 mb-2">
                            <label for="{{id}}" class="form-label">{{label}}</label>
                            {{#is_text}}
                                <input type="text" 
                                       id="{{id}}" 
                                       class="form-control" 
                                       placeholder="{{placeholder}}" />
                            {{/is_text}}
                            {{#is_select}}
                                <select id="{{id}}" class="form-control" onchange="filterTable('classmatesTable')">
                                    {{#options}}
                                        <option value="{{value}}">{{label}}</option>
                                    {{/options}}
                                </select>
                            {{/is_select}}
                        </div>
                        {{/filters}}
                        <div class="col-md-4 mb-2 d-flex align-items-end">
                            <button type="button" class="btn btn-outline-secondary" onclick="clearAllFilters('classmatesTable')">
                                <i class="fas fa-times"></i> {{#str}}clearfilters, mod_pluginpatroller{{/str}}
                            </button>
                        </div>
                    </div>
                    <div class="row mt-2">
                        <div class="col-12">
                            <small id="filterCounter" class="text-muted"></small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {{/has_classmates}}

    {{#has_classmates}}
    <div class="row">
        <div class="col-12">
            <form method="post" action="" class="mb-4">
                <div class="card">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-table"></i> 
                            {{#str}}classmateslist, mod_pluginpatroller{{/str}}
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover mb-0" id="classmatesTable">
                                <thead class="thead-light">
                                    <tr>
                                        <th scope="col">
                                            <i class="fas fa-map-marker-alt"></i>
                                            {{#str}}campusandcourse, mod_pluginpatroller{{/str}}
                                        </th>
                                        <th scope="col">
                                            <i class="fas fa-user"></i>
                                            {{#str}}fullname, mod_pluginpatroller{{/str}}
                                        </th>
                                        <th scope="col">
                                            <i class="fab fa-github"></i>
                                            {{#str}}githubuser, mod_pluginpatroller{{/str}}
                                        </th>
                                        <th scope="col">
                                            <i class="fas fa-code-branch"></i>
                                            {{#str}}repositorygroup, mod_pluginpatroller{{/str}}
                                        </th>
                                        <th scope="col">
                                            <i class="fas fa-tools"></i>
                                            {{#str}}actions, mod_pluginpatroller{{/str}}
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#classmates}}
                                    <tr {{#is_current_user}}class="table-warning"{{/is_current_user}} data-fullname="{{full_name}}">
                                        <td>{{my_sede_curso}}</td>
                                        <td>
                                            {{#is_current_user}}
                                                <strong>{{full_name}} {{#str}}you, mod_pluginpatroller{{/str}}</strong>
                                            {{/is_current_user}}
                                            {{^is_current_user}}
                                                {{full_name}}
                                            {{/is_current_user}}
                                        </td>
                                        <td>
                                            {{#can_edit}}
                                                <input type="text" 
                                                       name="github_username" 
                                                       value="{{github_username}}" 
                                                       class="form-control form-control-sm"
                                                       placeholder="{{#str}}yourgithubusername, mod_pluginpatroller{{/str}}"
                                                       required>
                                            {{/can_edit}}
                                            {{^can_edit}}
                                                <span class="badge badge-secondary">{{github_username}}</span>
                                                {{#is_readonly}}
                                                    <small class="text-muted d-block">
                                                        <i class="fas fa-lock"></i> 
                                                        {{#str}}lockedstate, mod_pluginpatroller{{/str}}
                                                    </small>
                                                {{/is_readonly}}
                                            {{/can_edit}}
                                        </td>
                                        <td>
                                            {{#can_edit}}
                                                {{#has_available_repos}}
                                                <select name="repositorio" class="form-control form-control-sm">
                                                    {{#available_repositories}}
                                                    <option value="{{value}}" {{#selected}}selected{{/selected}}>
                                                        {{text}}
                                                    </option>
                                                    {{/available_repositories}}
                                                </select>
                                                {{/has_available_repos}}
                                                {{^has_available_repos}}
                                                    <span class="badge badge-warning">{{#str}}noreposavailable, mod_pluginpatroller{{/str}}</span>
                                                {{/has_available_repos}}
                                            {{/can_edit}}
                                            {{^can_edit}}
                                                <span class="badge badge-info">{{repository.name}}</span>
                                            {{/can_edit}}
                                        </td>
                                        <td>
                                            {{#can_edit}}
                                                <input type="hidden" name="alumno_id" value="{{id}}">
                                                <button type="submit" name="guardar_repositorio" value="1" class="btn btn-success btn-sm">
                                                    <i class="fas fa-save"></i>
                                                    {{#str}}save, mod_pluginpatroller{{/str}}
                                                </button>
                                            {{/can_edit}}
                                            {{^can_edit}}
                                                <small class="text-muted">No editable</small>
                                            {{/can_edit}}
                                        </td>
                                    </tr>
                                    {{/classmates}}
                                </tbody>
                            </table>
                           

                        </div>
                    </div>
                </div>
                <input type="hidden" name="id" value="{{cm_id}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
            </form>
        </div>
    </div>
    {{/has_classmates}}

    {{^has_classmates}}
    <div class="row">
        <div class="col-12">
            <div class="alert alert-warning">
                <i class="fas fa-exclamation-triangle"></i>
                <strong>{{#str}}noclassmatesregistered, mod_pluginpatroller{{/str}}</strong>
                <p class="mb-0 mt-2">
                    {{#str}}noclassmatesexplanation, mod_pluginpatroller{{/str}}
                </p>
            </div>
        </div>
    </div>
    {{/has_classmates}}
</div>

<!-- Scripts de filtros -->
<script type="text/javascript">
{{{filters_script}}}
</script>
<!-- Inline filter script for classmates table (search by full name) -->
<script>
function filterTable(tableId) {
    const table = document.getElementById(tableId || 'classmatesTable');
    if (!table) return;

    const nameFilter = document.getElementById('filterName')?.value.toLowerCase().trim() || '';

    const rows = table.querySelectorAll('tbody tr');
    let visible = 0;
    rows.forEach(row => {
        const fullname = (row.getAttribute('data-fullname') || '').toLowerCase().trim();
        const match = !nameFilter || fullname.includes(nameFilter);
        if (match) {
            row.style.display = '';
            visible++;
        } else {
            row.style.display = 'none';
        }
    });
    // update counter
    const counter = document.getElementById('filterCounter');
    if (counter) {
        const total = rows.length;
        if (visible === total) counter.textContent = `Mostrando todos los ${total} compañeros`;
        else counter.textContent = `Mostrando ${visible} de ${total} compañeros`;
    }
}

function clearAllFilters(tableId) {
    const nameEl = document.getElementById('filterName');
    if (nameEl) nameEl.value = '';
    filterTable(tableId || 'classmatesTable');
}

document.addEventListener('DOMContentLoaded', function() {
    const nameEl = document.getElementById('filterName');
    if (nameEl) nameEl.addEventListener('input', function() { filterTable('classmatesTable'); });
    // init counter
    filterTable('classmatesTable');
});
</script>