<?xml version="1.0" encoding="UTF-8"?>
<XMLDB PATH="mod/pluginpatroller/db" VERSION="2023101201" COMMENT="Estructura de la base de datos para el plugin patroller">
    <TABLES>
        <TABLE NAME="pluginpatroller" COMMENT="Tabla principal para el plugin patroller">
            <FIELDS>
                <!-- Datos requeridos por el moodle -->
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="ID único"/>
                <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Nombre de la instancia"/>
                <FIELD NAME="intro" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Introducción"/>
				<FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Formato de introducción"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Tiempo de creación"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Tiempo de modificación"/>
				<FIELD NAME="last_api_refresh" TYPE="char" LENGTH="30" NOTNULL="false" DEFAULT="" SEQUENCE="false" COMMENT="última actualización del API"/>
                <FIELD NAME="execution_interval" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="60" SEQUENCE="false" COMMENT="Intervalo de ejecución en minutos"/>
                <FIELD NAME="max_users_per_group" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="4" SEQUENCE="false" COMMENT="Cantidad máxima sugerida de alumnos por grupo"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id" COMMENT="Clave primaria"/>  
            </KEYS>
        </TABLE>

        <TABLE NAME="repositorios_data_patroller" COMMENT="Tabla de repos de plugin patroller">
            <FIELDS>
                <!-- Datos del Repositorio -->
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="ID único"/>
                <FIELD NAME="id_materia" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="ID repositorios"/>
                <FIELD NAME="sede" TYPE="char" LENGTH="255" NOTNULL="false" DEFAULT="" SEQUENCE="false" COMMENT="sede"/>
                <FIELD NAME="curso" TYPE="char" LENGTH="255" NOTNULL="false" DEFAULT="" SEQUENCE="false" COMMENT="Curso"/>
                <FIELD NAME="num_grupo" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" SEQUENCE="false" COMMENT="numero de grupo"/>
                <FIELD NAME="nombre_repo" TYPE="char" LENGTH="255" NOTNULL="false" DEFAULT="" SEQUENCE="false" COMMENT="Nombre Repositorio"/>
           </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id" COMMENT="Clave primaria"/>
                <KEY NAME="fk_materia" TYPE="foreign" FIELDS="id_materia" REFTABLE="course" REFFIELDS="id"/>
            </KEYS>
        </TABLE>

        <TABLE NAME="usuarios_data_patroller" COMMENT="Tabla de usuarios de plugin patroller">
            <FIELDS>
                <!-- Datos del Alumno en el Repositorio -->
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="ID único"/>
                <FIELD NAME="id_repo" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="ID repositorios"/>
                <FIELD NAME="id_usuario" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="ID usuario asignado en el curso"/>
                <FIELD NAME="id_materia" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="ID repositorios"/>
                <FIELD NAME="nombre_usuario" TYPE="char" LENGTH="255" NOTNULL="false" DEFAULT="" SEQUENCE="false" COMMENT="Nombre del usuario"/>
                <FIELD NAME="mail_usuario" TYPE="char" LENGTH="255" NOTNULL="false" DEFAULT="" SEQUENCE="false" COMMENT="Mail del usuario"/>
                <FIELD NAME="usuario_github" TYPE="char" LENGTH="255" NOTNULL="false" DEFAULT="" SEQUENCE="false" COMMENT="Usuario GitHub cargado en el aula. Debe coincidir con un usario existente."/>
				<FIELD NAME="cantidad_commits" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" SEQUENCE="false" COMMENT="cantidad_commits"/>
                <FIELD NAME="lineas_agregadas" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" SEQUENCE="false" COMMENT="lineas_agregadas"/>
                <FIELD NAME="lineas_eliminadas" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" SEQUENCE="false" COMMENT="lineas_eliminadas"/>
                <FIELD NAME="lineas_modificadas" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" SEQUENCE="false" COMMENT="lineas_modificadas"/>
                <FIELD NAME="fecha_ultimo_commit" TYPE="char" LENGTH="30" NOTNULL="false" DEFAULT="" SEQUENCE="false" COMMENT="fecha_ultimo_commit"/>
                <FIELD NAME="calificacion" TYPE="char" LENGTH="10" NOTNULL="false" DEFAULT="" SEQUENCE="false" COMMENT="calificacion del alumno"/>
                <FIELD NAME="invitacion_status" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" SEQUENCE="false" COMMENT="Indica el estado de la invitación al usuario"/>       
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id" COMMENT="Clave primaria"/>
                <KEY NAME="fk_repos" TYPE="foreign" FIELDS="id_repo" REFTABLE="repositorios_data_patroller" REFFIELDS="id"/>
                <KEY NAME="fk_alumno" TYPE="foreign" FIELDS="id_usuario" REFTABLE="user" REFFIELDS="id"/>
                <KEY NAME="fk_materia" TYPE="foreign" FIELDS="id_materia" REFTABLE="course" REFFIELDS="id"/>
            </KEYS>
        </TABLE>
        <!-- Tabla de asociación entre repositorios y profesores -->
        <TABLE NAME="repos_profesores" COMMENT="Relación repositorio - profesor (asociaciones)">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="ID único"/>
                <FIELD NAME="repo_id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="ID del repositorio (repositorios_data_patroller.id)"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="ID del usuario profesor (user.id)"/>
                <FIELD NAME="github_username" TYPE="char" LENGTH="191" NOTNULL="false" SEQUENCE="false" COMMENT="Usuario GitHub del profesor en el momento de la asociación"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Timestamp de creación"/>
                <!-- NUEVO: Estado de la invitación -->
                <FIELD NAME="invitacion_status" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" SEQUENCE="false" COMMENT="Estado de invitación: 0=sin procesar, 1=enviada, 2=error, 3=aceptado"/>
                <!-- NUEVO: Última actualización del estado -->
                <FIELD NAME="invitacion_status_updated" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" SEQUENCE="false" COMMENT="Timestamp última actualización del estado"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id" COMMENT="Clave primaria"/>
                <KEY NAME="unique_repo_user" TYPE="unique" FIELDS="repo_id,userid" COMMENT="Evita duplicados"/>
                <KEY NAME="fk_repo" TYPE="foreign" FIELDS="repo_id" REFTABLE="repositorios_data_patroller" REFFIELDS="id"/>
                <KEY NAME="fk_user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
            </KEYS>
        </TABLE>
    </TABLES>
</XMLDB>